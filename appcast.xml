        <item>
            <title>TML Tunnel Manager v6.9.6.1</title>
            <pubDate>Sat, 17 Oct 2026 13:00:00 +0000</pubDate>
            <sparkle:version>30</sparkle:version>
            <sparkle:shortVersionString>6.9.6.1</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
            <description><![CDATA[
                <h3>What's new in v6.9.6.1</h3>
                <ul>
                    <li>Fixed: About window now correctly shows the current version</li>
                    <li>Fixed: Entering BuyPass code after reconnect (sleep/wake or network drop) now works correctly</li>
                    <li>Fixed: Tunnels no longer race to reconnect after waking from sleep, preventing the BuyPass prompt from being cancelled mid-entry</li>
                    <li>Fixed: Dependent tunnels (e.g. ssh-osl) now wait cleanly for their dependency to finish authenticating before connecting</li>
                </ul>
            ]]></description>
            <enclosure
                url="https://github.com/hassan-alaie/tml-tunnel-manager/releases/download/v6.9.6.1/TML.Tunnel.Manager.6.9.6.1.zip"
